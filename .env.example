# NexusMart Marketplace Environment Variables

# Currency Settings
NEXT_PUBLIC_CURRENCY_SYMBOL="$"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database (e.g., Supabase / Neon / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/nexusmart?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/nexusmart?schema=public"

# Authentication (Optional / Future NextAuth integration)
NEXTAUTH_SECRET="your-32-character-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Payment Gateway (Optional / Stripe sandbox)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
